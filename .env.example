# ── Фронтенд ────────────────────────────────────────────────────────────────
# Базовый URL API. На Vercel фронт и API живут на одном домене, поэтому "/api".
# Для локальной разработки со старым server.js: http://localhost:4000
VITE_API_BASE_URL=/api

# ── Бэкенд (serverless-функции в папке api/) ────────────────────────────────
# Строка подключения MongoDB Atlas.
# Берётся в Atlas → Database → Connect → Drivers.
MONGODB_URI=mongodb+srv://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=nordwear

# Секрет для подписи токенов сессии. Минимум 32 случайных символа.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=замените_на_длинную_случайную_строку

# ── Только для разовой миграции (scripts/migrate-to-mongo.mjs) ──────────────
# Учётка администратора. Пароль будет захеширован, в базе открытым не хранится.
ADMIN_EMAIL=admin@nordwear.uz
ADMIN_PASSWORD=придумайте_длинный_пароль_минимум_10_символов
