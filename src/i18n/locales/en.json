  "infoPages": {
    "sustainability": {
      "title": "Sustainability",
      "intro": "At Nord Wear we believe good style shouldn't cost the planet. Here's how we try to keep our footprint small.",
      "section1Title": "Materials we choose",
      "section1Body": "We prioritize durable cottons, recycled blends, and long-lasting construction over disposable fast fashion, so every piece is built to be worn for years, not seasons.",
      "section2Title": "Packaging",
      "section2Body": "Orders ship in minimal, recyclable packaging. We're steadily phasing out single-use plastic from our supply chain.",
      "section3Title": "Made to last",
      "section3Body": "We'd rather sell you one great hoodie that lasts five years than five that fall apart in one. Quality control and honest sizing help reduce returns and waste."
    },
    "support": {
      "title": "Support",
      "intro": "Have a question about an order, sizing, or something else? We're here to help.",
      "section1Title": "Contact us",
      "section1Body": "Email support@nordwear.uz and our team will get back to you, usually within 1-2 business days.",
      "section2Title": "Orders & returns",
      "section2Body": "You can track the status of any order from the Orders page once you're signed in. For exchanges or returns, reach out with your order number and we'll sort it out.",
      "section3Title": "Before you write in",
      "section3Body": "Check the Delivery and Privacy pages - a lot of common questions about shipping times, payment methods, and how we handle your data are answered there."
    },
    "privacy": {
      "title": "Privacy Policy",
      "intro": "This page explains, in plain language, what information Nord Wear collects and how it's used.",
      "section1Title": "What we collect",
      "section1Body": "When you create an account or place an order, we store your name, email, phone number, and delivery address - nothing more than what's needed to get your order to you.",
      "section2Title": "How we use it",
      "section2Body": "Your details are used to process orders, keep you signed in, and contact you about delivery. We do not sell your information to third parties.",
      "section3Title": "Your data, your call",
      "section3Body": "You can ask us to update or delete your account data at any time by contacting support@nordwear.uz."
    },
    "delivery": {
      "title": "Delivery",
      "intro": "We currently deliver across Uzbekistan, with two speed options at checkout.",
      "section1Title": "Delivery options",
      "section1Body": "Standard delivery costs 30 000 UZS. Express delivery (45 000 UZS) is available in select cities for faster handoff.",
      "section2Title": "Coverage",
      "section2Body": "We currently ship to Toshkent, Samarqand, and Buxoro, with more cities being added over time.",
      "section3Title": "Payment",
      "section3Body": "Cash on delivery is available now. Card payments via CLICK, Payme, and Uzcard/Humo are coming soon."
    }
