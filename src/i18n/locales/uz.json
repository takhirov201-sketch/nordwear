  "infoPages": {
    "sustainability": {
      "title": "Barqarorlik",
      "intro": "Nord Wear'da biz chiroyli uslub sayyoramizga zarar keltirmasligi kerak, deb hisoblaymiz. Mana biz o'z izimizni qanday kamaytirishga harakat qilamiz.",
      "section1Title": "Biz tanlagan materiallar",
      "section1Body": "Biz bir martalik tez modadan ko'ra chidamli paxta, qayta ishlangan matolar va sifatli tikuvni afzal ko'ramiz — har bir buyum bir fasl emas, yillar davomida kiyilishi uchun yaratiladi.",
      "section2Title": "Qadoqlash",
      "section2Body": "Buyurtmalar minimal, qayta ishlanadigan qadoqda yuboriladi. Biz yetkazib berish zanjirida bir martalik plastikdan asta-sekin voz kechmoqdamiz.",
      "section3Title": "Uzoq muddat uchun yaratilgan",
      "section3Body": "Besh yil xizmat qiladigan bitta ajoyib hudi sotish, bir fasldan keyin yirtiladigan beshtasini sotishdan yaxshiroq. Sifat nazorati va halol o'lchamlar qaytarishlar va isrofgarchilikni kamaytiradi."
    },
    "support": {
      "title": "Yordam markazi",
      "intro": "Buyurtma, o'lcham yoki boshqa savolingiz bormi? Biz yordam berishga tayyormiz.",
      "section1Title": "Biz bilan bog'laning",
      "section1Body": "support@nordwear.uz manziliga yozing — odatda 1-2 ish kuni ichida javob beramiz.",
      "section2Title": "Buyurtmalar va qaytarishlar",
      "section2Body": "Tizimga kirganingizdan so'ng istalgan buyurtma holatini «Buyurtmalar» sahifasida kuzatishingiz mumkin. Almashtirish yoki qaytarish uchun buyurtma raqamingiz bilan murojaat qiling — biz yechim topamiz.",
      "section3Title": "Yozishdan oldin",
      "section3Body": "«Yetkazib berish» va «Maxfiylik» sahifalarini ko'rib chiqing — yetkazib berish muddatlari, to'lov usullari va ma'lumotlaringiz qanday ishlatilishi haqida ko'p savollarga javob shu yerda bor."
    },
    "privacy": {
      "title": "Maxfiylik siyosati",
      "intro": "Ushbu sahifada Nord Wear qanday ma'lumotlarni to'plashi va ulardan qanday foydalanishi oddiy tilda tushuntirilgan.",
      "section1Title": "Biz nimalarni to'playmiz",
      "section1Body": "Hisob yaratganingizda yoki buyurtma berganingizda biz ismingiz, email, telefon raqamingiz va yetkazib berish manzilingizni saqlaymiz — buyurtmangizni yetkazish uchun zarur bo'lganidan ortiq emas.",
      "section2Title": "Ulardan qanday foydalanamiz",
      "section2Body": "Ma'lumotlaringiz buyurtmalarni qayta ishlash, hisobingizga kirishni ta'minlash va yetkazib berish bo'yicha bog'lanish uchun ishlatiladi. Biz ma'lumotlaringizni uchinchi shaxslarga sotmaymiz.",
      "section3Title": "Ma'lumotlaringiz — sizning tanlovingiz",
      "section3Body": "Istalgan vaqtda support@nordwear.uz manziliga yozib, hisobingiz ma'lumotlarini yangilash yoki o'chirishni so'rashingiz mumkin."
    },
    "delivery": {
      "title": "Yetkazib berish",
      "intro": "Hozircha biz O'zbekiston bo'ylab yetkazib beramiz, buyurtma berishda ikkita tezlik varianti mavjud.",
      "section1Title": "Yetkazib berish variantlari",
      "section1Body": "Standart yetkazib berish 30 000 so'm turadi. Tezkor yetkazib berish (45 000 so'm) tanlangan shaharlarda tezroq yetkazish uchun mavjud.",
      "section2Title": "Qamrov hududi",
      "section2Body": "Hozircha Toshkent, Samarqand va Buxoroga yetkazib beramiz, shaharlar ro'yxati asta-sekin kengaytirilmoqda.",
      "section3Title": "To'lov",
      "section3Body": "Hozircha naqd pulda to'lash mavjud. CLICK, Payme va Uzcard/Humo orqali karta bilan to'lash tez orada qo'shiladi."
    }
  }
}
